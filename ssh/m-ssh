#!/bin/bash

clear

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${CYAN}"
echo "╔══════════════════════════════╗"
echo "║        MENU SSH WS          ║"
echo "╚══════════════════════════════╝"
echo -e "${NC}"

echo -e "${YELLOW} 1.${NC} Add SSH Account"
echo -e "${YELLOW} 2.${NC} Trial SSH Account"
echo -e "${YELLOW} 3.${NC} Renew SSH Account"
echo -e "${YELLOW} 4.${NC} Delete SSH Account"
echo -e "${YELLOW} 5.${NC} Check User Login"
echo -e "${YELLOW} 6.${NC} List Member SSH"
echo -e "${YELLOW} 7.${NC} Delete Expired SSH"
echo -e "${YELLOW} 8.${NC} Check Service SSH"
echo -e "${YELLOW} 9.${NC} Restart Service SSH"
echo -e "${YELLOW} x.${NC} Exit"

echo ""
read -p "Select Menu : " x

case $x in

1)
clear
bash /etc/autoscriptvpn/ssh/addssh.sh
;;

2)
clear
echo "Trial SSH - Coming Soon"
;;

3)
clear
echo "Renew SSH - Coming Soon"
;;

4)
clear
echo "Delete SSH - Coming Soon"
;;

5)
clear
echo "Check Login SSH - Coming Soon"
;;

6)
clear
echo "List Member SSH - Coming Soon"
;;

7)
clear
echo "Delete Expired SSH - Coming Soon"
;;

8)
clear
systemctl status ssh --no-pager
echo ""
systemctl status dropbear --no-pager
echo ""
systemctl status ws-dropbear --no-pager
echo ""
systemctl status ws-stunnel --no-pager
echo ""
systemctl status udp-custom --no-pager
echo ""
systemctl status udpgw --no-pager
;;

9)
clear

systemctl restart ssh
systemctl restart dropbear
systemctl restart ws-dropbear
systemctl restart ws-stunnel
systemctl restart udp-custom
systemctl restart udpgw

echo ""
echo -e "${GREEN}[ OK ] All SSH Service Restarted${NC}"
echo ""

;;

x)
exit
;;

*)
echo "❌ Pilihan salah!"
sleep 1
exec m-ssh
;;
esac
